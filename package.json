{
  "name": "scout-trail-map",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:offline": "npm run build && playwright test --config playwright.offline.config.js",
    "fonts:sync": "node scripts/sync-font-subsets.mjs",
    "predev": "npm run sync:index && npm run fonts:sync",
    "prebuild": "npm run sync:index && npm run fonts:sync",
    "check:slim": "node scripts/guard.mjs --assets",
    "guard": "node scripts/guard.mjs",
    "final-check": "node scripts/final_check_v1.0.mjs",
    "sync:index": "node scripts/sync-index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@tomickigrzegorz/leaflet-rotate": "^0.3.0",
    "@zip.js/zip.js": "^2.24.0",
    "geotiff": "^2.1.3",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "magvar": "^2.2.0",
    "pako": "^2.2.0",
    "proj4": "^2.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^26.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
