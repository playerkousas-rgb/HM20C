# Server-side environment variables. Copy to .env.local for local testing;
# never commit or share actual credentials, or give them a VITE_ prefix.
LEADER_PASSWORD=

# Optional: a persistent Upstash Redis REST database for online activities.
# Configure either this complete pair OR the Vercel Marketplace KV pair below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# LOCAL TESTING ONLY. The in-memory store is lost on process restart, is not
# shared between instances, and is never used by deployed Vercel functions.
# ACTIVITY_DEV_MEMORY=1
