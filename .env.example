# Server-side environment variables. Copy to .env.local for local testing;
# never commit or share actual credentials, or give secrets a VITE_ prefix.
LEADER_PASSWORD=

# High-entropy server-side signing secret. Production Cloudflare and Vercel
# must use the same independent value and the same leader password.
LEADER_SESSION_SECRET=

# Public HTTPS address of the Cloudflare Worker, ending in /api/activity.
# This URL is not a secret. It is required when building for production.
VITE_ACTIVITY_API_URL=

# LOCAL TESTING ONLY. The in-memory store is lost on restart and never used
# as a silent fallback in production. Vite dev uses it at /api/activity.
# ACTIVITY_DEV_MEMORY=1

# LEGACY REDIS ONLY: not used by the Cloudflare Free setup. Explicitly enabling
# the legacy Vercel endpoint may incur third-party usage or charges.
# ACTIVITY_ALLOW_LEGACY_REDIS=1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
